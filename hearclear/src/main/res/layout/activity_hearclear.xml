<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/hc_page" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="12dp">
            <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/hc_logo" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="14dp">
                <TextView style="@style/HcHeading" android:text="HearClear" android:textSize="17sp" android:paddingBottom="0dp" />
                <TextView style="@style/HcBody" android:text="Closer to the conversation" android:textSize="14sp" android:visibility="gone" />
            </LinearLayout>
            <Button
                android:id="@+id/shareAppButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Share app"
                android:textAllCaps="false"
                android:contentDescription="Share HearClear app link" />
        </LinearLayout>
        <Button android:id="@+id/accountButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Account · trial / lifetime access" />
        
        <LinearLayout style="@style/HcCard" android:background="@drawable/hc_soft">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:id="@+id/headphoneIcon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/hc_headphones" android:importantForAccessibility="no" />
                <TextView android:id="@+id/connectionStatus" style="@style/HcBody" android:text="Checking headphones…" android:textStyle="bold" android:textColor="@color/hc_accent" android:accessibilityLiveRegion="polite" android:layout_width="0dp" android:layout_weight="1" android:paddingStart="8dp" android:textSize="13sp" />
            </LinearLayout>
            <TextView android:id="@+id/listeningTitle" style="@style/HcHeading" android:text="Ready when you are" android:textSize="22sp" android:paddingTop="6dp" android:paddingBottom="4dp" android:visibility="gone" />
            <TextView android:id="@+id/listeningHint" style="@style/HcBody" android:text="Connect headphones, then tap Start listening." />
            <TextView android:id="@+id/listeningError" style="@style/HcBody" android:textColor="@color/hc_error" android:visibility="gone" android:paddingTop="8dp" android:accessibilityLiveRegion="polite" />
            <Button android:id="@+id/startButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="10dp" android:background="@drawable/hc_action" android:backgroundTint="@null" android:text="Start listening" android:textColor="@color/hc_white" android:textSize="18sp" android:textAllCaps="false" android:textStyle="bold" android:padding="10dp" />
        </LinearLayout>
        <LinearLayout style="@style/HcCard">
            <TextView style="@style/HcHeading" android:text="Sound boost" />
            <TextView style="@style/HcBody" android:text="Start low and raise it slowly." android:visibility="gone" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingTop="4dp">
                <Button android:id="@+id/boostLess" android:layout_width="48dp" android:layout_height="wrap_content" android:minHeight="48dp" android:text="−" android:textSize="22sp" android:contentDescription="Decrease sound boost" />
                <TextView android:id="@+id/boostValue" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="1×" android:textSize="28sp" android:textStyle="bold" android:textColor="@color/hc_accent" android:gravity="center" android:accessibilityLiveRegion="polite" />
                <Button android:id="@+id/boostMore" android:layout_width="48dp" android:layout_height="wrap_content" android:minHeight="48dp" android:text="+" android:textSize="22sp" android:contentDescription="Increase sound boost" />
            </LinearLayout>
            <SeekBar android:id="@+id/boostBar" style="@style/HcSlider" android:max="19" android:progress="0" android:contentDescription="Sound boost, one to twenty times" />
            <TextView style="@style/HcBody" android:text="Phone buttons control headphone volume." android:textSize="14sp" />
            <Switch android:id="@+id/rnnoiseSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="RNNoise speech reduction" android:textSize="15sp" android:paddingEnd="4dp" />
            <TextView style="@style/HcBody" android:id="@+id/rnnoiseHint" android:text="Offline neural noise reduction. Try it alone first; 48 kHz required." android:textSize="12sp" />
            <Switch android:id="@+id/softwareSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Reduce low rumble" android:textSize="15sp" android:paddingEnd="4dp" />
            <Switch android:id="@+id/noiseSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Phone noise reduction" android:textSize="15sp" android:paddingEnd="4dp" />
            <TextView style="@style/HcBody" android:text="Try one sound option at a time." android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout style="@style/HcCard">
            <Button android:id="@+id/earsButton" style="@style/HcSectionButton" android:text="More settings  ▾" />
            <LinearLayout android:id="@+id/earsPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView style="@style/HcHeading" android:text="Ear adjustments" />
                <TextView style="@style/HcBody" android:text="Adjust one side at a time. Turn off Android Mono audio for separate ear controls." android:paddingBottom="12dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:padding="4dp">
                        <TextView android:id="@+id/leftLevelLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Left · 100%" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/hc_ink" />
                        <com.dipak.hearclear.VerticalLevelControl android:id="@+id/leftLevelBar" android:layout_width="match_parent" android:layout_height="132dp" android:contentDescription="Left ear level" />
                        <TextView android:id="@+id/leftToneLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Left tone · 0 dB" android:textSize="12sp" android:textColor="@color/hc_muted" />
                        <SeekBar android:id="@+id/leftToneBar" android:layout_width="match_parent" android:layout_height="48dp" android:max="12" android:progress="6" android:contentDescription="Left speech tone" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:padding="4dp">
                        <TextView android:id="@+id/rightLevelLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Right · 100%" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/hc_ink" />
                        <com.dipak.hearclear.VerticalLevelControl android:id="@+id/rightLevelBar" android:layout_width="match_parent" android:layout_height="132dp" android:contentDescription="Right ear level" />
                        <TextView android:id="@+id/rightToneLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Right tone · 0 dB" android:textSize="12sp" android:textColor="@color/hc_muted" />
                        <SeekBar android:id="@+id/rightToneBar" android:layout_width="match_parent" android:layout_height="48dp" android:max="12" android:progress="6" android:contentDescription="Right speech tone" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout style="@style/HcCard">
                    <Button android:id="@+id/detailsButton" style="@style/HcSectionButton" android:text="Connection details  ▾" />
                    <LinearLayout android:id="@+id/detailsPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                        <TextView android:id="@+id/diagnosticsText" style="@style/HcBody" android:textSize="13sp" android:textIsSelectable="true" android:text="Start listening to see actual routes and effect status." />
                    </LinearLayout>
                </LinearLayout>
                <Button android:id="@+id/resetButton" style="@style/HcSectionButton" android:text="Reset sound settings" android:gravity="center" android:textColor="@color/hc_accent" />
                <Button style="@style/HcSectionButton" android:id="@+id/licensesButton" android:text="RNNoise open-source licence" android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
        <TextView style="@style/HcBody" android:textSize="13sp" android:paddingTop="4dp" android:paddingBottom="8dp" android:text="Share the GitHub download link. Installs and updates are manual; download counts do not show how many people use the app." />
        <TextView style="@style/HcBody" android:textSize="13sp" android:paddingBottom="8dp" android:text="Experimental assistance, not a fitted hearing aid. Output is not calibrated to safe ear-level loudness. Start low; stop if uncomfortable." />
    </LinearLayout>
</ScrollView>
