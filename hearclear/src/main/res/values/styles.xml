<resources>
    <style name="HearClearTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/hc_accent</item>
        <item name="android:windowBackground">@color/hc_page</item>
        <item name="android:textColorPrimary">@color/hc_ink</item>
        <item name="android:textColorSecondary">@color/hc_muted</item>
        <item name="android:statusBarColor">@color/hc_page</item>
        <item name="android:navigationBarColor">@color/hc_page</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="HcCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:background">@drawable/hc_card</item>
    </style>
    <style name="HcBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/hc_muted</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="HcHeading" parent="HcBody">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/hc_ink</item>
        <item name="android:paddingBottom">8dp</item>
    </style>
    <style name="HcSectionButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">@color/hc_ink</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:padding">4dp</item>
    </style>
    <style name="HcSlider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
    </style>
</resources>
